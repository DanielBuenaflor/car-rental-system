# ============================================================
# Car Rental System - Environment Variables
# Copy this file to .env and fill in your actual values.
# ============================================================

# ---------------------
# Flask Settings
# ---------------------
# Secret key for session signing and CSRF protection. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# Set to True to enable Flask debug mode and auto-reloader.
FLASK_DEBUG=False

# Base URL of the running application. Used for generating absolute URLs
# (e.g., payment callbacks, email verification links).
# Change this to your public URL when deploying.
BASE_URL=http://localhost:5000

# ---------------------
# Database Credentials
# ---------------------
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=car_rental_system

# ---------------------
# Mail Server Settings
# ---------------------
# SMTP server hostname (default: smtp.gmail.com for Gmail).
MAIL_SERVER=smtp.gmail.com

# SMTP port. 587 for TLS, 465 for SSL.
MAIL_PORT=587

# Enable TLS for the SMTP connection. Keep True for port 587.
MAIL_USE_TLS=True

# SMTP login credentials.
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# Default "From" address for outgoing emails.
MAIL_DEFAULT_SENDER=noreply@carrentalpro.com

# ---------------------
# PayMongo (GCash) API Keys
# ---------------------
# Obtain from https://dashboard.paymongo.com
# Use sandbox keys for testing, live keys for production.
PAYMONGO_SECRET_KEY=sk_test_your_secret_key
PAYMONGO_PUBLIC_KEY=pk_test_your_public_key
PAYMONGO_WEBHOOK_SECRET=whsk_your_webhook_secret

# "sandbox" for testing, "live" for production.
PAYMONGO_MODE=sandbox

# ---------------------
# Stripe API Keys
# ---------------------
# Obtain from https://dashboard.stripe.com
STRIPE_PUBLIC_KEY=pk_test_your_public_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ---------------------
# PayPal API Keys
# ---------------------
# Obtain from https://developer.paypal.com
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# "sandbox" for testing, "live" for production.
PAYPAL_MODE=sandbox

# ---------------------
# OCR (Tesseract)
# ---------------------
# Path to the Tesseract OCR executable.
# On Windows, e.g.: C:\Program Files\Tesseract-OCR\tesseract.exe
# On Linux/macOS, e.g.: /usr/bin/tesseract
# Leave empty if Tesseract is already on your PATH.
TESSERACT_CMD=
# GCash/PayMongo API Keys
# Get test keys from: https://dashboard.paymongo.com (Developers → API Keys → Test Mode)
GCASH_API_KEY=your_gcash_api_key_here
PAYMONGO_SECRET_KEY=sk_test_your_secret_key
PAYMONGO_PUBLIC_KEY=pk_test_your_public_key
PAYMONGO_WEBHOOK_SECRET=whsk_your_webhook_secret
PAYMONGO_MODE=sandbox

# Base URL - change to your local or deployed app URL
BASE_URL=http://localhost:5000

# Flask secret key - generate a new one for production
SECRET_KEY=your_secret_key_here

# Email Configuration (use your SMTP credentials)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_DEFAULT_SENDER=noreply@yourdomain.com

# Database Connection
DB_HOST=localhost
DB_USER=car_user
DB_PASSWORD=your_db_password
DB_NAME=car_rental_system

# MySQL Configuration
MYSQL_USER=car_user
MYSQL_PASSWORD=your_db_password
MYSQL_DATABASE=car_rental_system
MYSQL_ROOT_PASSWORD=your_root_password

# Optional ngrok Auth (only if you use ngrok for local webhook testing)
NGROK_AUTHTOKEN=your_ngrok_auth_token

# OCR.space API Key (Get free key from https://ocr.space/ocrapi/freekey)
OCR_API_KEY=your_ocr_space_api_key

# Other Payment Providers (not currently in use)
STRIPE_PUBLIC_KEY=unused
STRIPE_SECRET_KEY=unused
STRIPE_WEBHOOK_SECRET=unused
PAYPAL_CLIENT_ID=unused
PAYPAL_CLIENT_SECRET=unused

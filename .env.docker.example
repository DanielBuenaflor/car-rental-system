# ============================================================
# Car Rental System - Docker Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# Flask settings
SECRET_KEY=your-secret-key-here-generate-with-python-secrets-token-hex-32
FLASK_DEBUG=False
BASE_URL=http://localhost:5000

# Database
DB_HOST=db
DB_PORT=3306
DB_NAME=car_rental_system
DB_USER=carrental
DB_PASSWORD=your-strong-db-password

# Mail (SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@carrental.com

# PayMongo (GCash)
PAYMONGO_SECRET_KEY=sk_test_your_key
PAYMONGO_PUBLIC_KEY=pk_test_your_key
PAYMONGO_WEBHOOK_SECRET=whsk_your_key
PAYMONGO_MODE=sandbox

# Stripe
STRIPE_PUBLIC_KEY=pk_test_your_key
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_key

# PayPal
PAYPAL_CLIENT_ID=your-client-id
PAYPAL_CLIENT_SECRET=your-client-secret
PAYPAL_MODE=sandbox

# ngrok Tunnel
NGROK_AUTHTOKEN=your-ngrok-auth-token
NGROK_HOSTNAME=your-custom-domain.ngrok.io  # Optional: custom subdomain